#!/usr/bin/env python3
"""Claude Code hook: replay each Edit/Write as live typing in Zed / VS Code (both auto-reload from disk).

PreToolUse snapshots the file; PostToolUse rewinds it and re-types only the changed words.
  claude-typing speed [N]  show / set typing speed in chars per second (applies live)
  claude-typing off|on     toggle (off also fast-forwards an edit in progress)
  claude-typing selftest   run the self-check
"""
import difflib
import hashlib
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_CPS = 30.0
DELETE_SPEEDUP = 4  # removed text disappears faster than new text is typed
AFTER_PAUSE = 0.5  # seconds to see a finished change before moving on
FILE_PAUSE = 4  # seconds to look at a finished file before jumping to a different one

STATE_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "claude-typing"
OFF = STATE_DIR / "off"
KEEP_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "claude-typing"
SPEED_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "claude-typing" / "speed"


def read(path):
    with open(path, encoding="utf-8", errors="surrogateescape", newline="") as f:
        return f.read()


def write(path, text):
    with open(path, "w", encoding="utf-8", errors="surrogateescape", newline="") as f:
        f.write(text)


def speed():
    try:
        return max(1.0, float(SPEED_FILE.read_text()))
    except (OSError, ValueError):
        return DEFAULT_CPS


TOKEN = re.compile(r"\w+|[^\S\n]+|\n|[^\w\s]")
MAX_WORD_DIFF = 4_000_000  # token pairs; bigger blocks are retyped whole instead of diffed word by word


def word_changes(x, y):
    """(start, end) in x and (start, end) in y of each changed run, left to right, at word level.
    Unchanged runs without a word between two changes are folded in, so typing doesn't hop around."""
    tx, ty = TOKEN.findall(x), TOKEN.findall(y)
    if len(tx) * len(ty) > MAX_WORD_DIFF:
        return [(0, len(x), 0, len(y))] if x != y else []
    runs = []
    gap = None
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, tx, ty, autojunk=False).get_opcodes():
        if tag == "equal":
            gap = (i1, i2)
        elif runs and (gap is None or not re.search(r"\w", "".join(tx[gap[0] : gap[1]]))):
            runs[-1][1], runs[-1][3] = i2, j2
        else:
            runs.append([i1, i2, j1, j2])
            gap = None
    cx = [0]
    for t in tx:
        cx.append(cx[-1] + len(t))
    cy = [0]
    for t in ty:
        cy.append(cy[-1] + len(t))
    return [(cx[i1], cx[i2], cy[j1], cy[j2]) for i1, i2, j1, j2 in runs]


def caret_col(out, piece):
    """1-based column of the end of out + piece."""
    i = piece.rfind("\n")
    return len(piece) - i if i >= 0 else len(out) - out.rfind("\n") + len(piece)


def frames(old, new):
    """Yield ("jump", line, col), ("show", text, seconds) and ("key", text, weight, line, col) frames
    from old to new; a key frame's line and col are where its typing point (caret) sits."""
    a, b = old.splitlines(keepends=True), new.splitlines(keepends=True)
    ops = [op for op in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes() if op[0] != "equal"]
    # every key frame carries the typing point's line and column, so the cursor can follow each keystroke
    for _, i1, i2, j1, j2 in ops:
        x, y = "".join(a[i1:i2]), "".join(b[j1:j2])
        # earlier blocks are already final (b), later ones are still old (a)
        done, rest = "".join(b[:j1]), "".join(a[i2:])
        out_nl = done.count("\n")
        yield ("jump", out_nl + 1, 1)
        yield ("show", done + x + rest, 1.0)
        out, pos = done, 0
        for xs, xe, ys, ye in word_changes(x, y):
            out += x[pos:xs]
            out_nl += x.count("\n", pos, xs)
            gone, typed, tail = x[xs:xe], y[ys:ye], x[xe:] + rest
            nl = gone.count("\n")
            for k in range(len(gone) - 1, -1, -1):
                if gone[k] == "\n":
                    nl -= 1
                yield ("key", out + gone[:k] + tail, 1 / DELETE_SPEEDUP, out_nl + nl + 1, caret_col(out, gone[:k]))
            k = nl = 0
            while k < len(typed):
                start = k
                k += 1
                while k < len(typed) and typed[k - 1] in " \t" and typed[k] in " \t":
                    k += 1  # indentation lands at once
                nl += typed.count("\n", start, k)
                yield ("key", out + typed[:k] + tail, 1, out_nl + nl + 1, caret_col(out, typed[:k]))
            out, pos, out_nl = out + typed, xe, out_nl + nl
        yield ("show", out + x[pos:] + rest, AFTER_PAUSE)


# jump to line and column, so the editor's cursor sits where the typing is
def editor_cmd(path, line, col=1):
    """Command that focuses path:line:col in the editor this Claude runs under, or None."""
    pid = os.getppid()
    while pid > 1:
        try:
            comm = Path(f"/proc/{pid}/comm").read_text().strip()
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            return None
        if comm in ("zed-editor", "zed", "zeditor"):
            return ["zed", f"{path}:{line}:{col}"]
        if comm in ("code", "code-oss", "codium"):
            return ["code", "-g", f"{path}:{line}:{col}"]
        pid = int(stat.rsplit(")", 1)[1].split()[1])
    return None


def jump(path, line, col=1):
    cmd = editor_cmd(path, line, col)
    if cmd:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5, check=False)


def animate(path, steps, size):
    # write each frame to disk, then put the cursor on that frame's typing point
    min_gap = max(1 / 30, size / 20_000_000)  # multi-MB files: fewer, bigger writes so the editor keeps up
    last = 0.0
    pending = None  # newest key frame (text, line, col) not written yet because of min_gap
    due = time.monotonic()  # when the next keystroke is due; writes and jumps don't slow the pace
    for kind, *rest in steps:
        if OFF.exists():
            return
        if kind == "jump":
            # write the latest frame first, so the line being jumped to exists in the editor
            if pending is not None:
                write(path, pending[0])
                pending, last = None, time.monotonic()
            jump(path, *rest)
            continue
        if kind == "show":
            text, t = rest
            write(path, text)
            pending, last = None, time.monotonic()
            time.sleep(t)
            due = time.monotonic()
            continue
        text, t, line, col = rest
        due += t / speed()
        time.sleep(max(0.0, due - time.monotonic()))
        if time.monotonic() - last >= min_gap:
            write(path, text)
            jump(path, line, col)
            pending, last = None, time.monotonic()
        else:
            pending = (text, line, col)


def selftest():
    cases = [
        ("a\nb\nc\n", "a\nB!\nc\nd\n"),
        ("", "hello\nworld\n"),
        ("x\ny\n", ""),
        ("same\n", "same\n"),
        ("def f():\n    return 1\n", "def f():\n        return 2  # two\n"),
        ("r\r\nn\r\n", "r\r\nm\r\n"),
    ]
    for old, new in cases:
        shown = [f[1] for f in frames(old, new) if f[0] == "show"]
        assert (shown[-1] if shown else old) == new, (old, new)
    # a step comment loses only its "Step N: " prefix, then the code is typed under it
    keys = [f[1] for f in frames("# Step 1: add y\nx = 1\n", "# add y\ny = 2\nx = 1\n") if f[0] == "key"]
    assert all("add y" in k for k in keys) and "# add y\nx = 1\n" in keys, keys[:3]
    # every key frame's caret must sit on a line of that frame, moving down when typing, up when deleting
    long = "a\n" + "".join(f"v{i} = {i}\n" for i in range(60))
    for old, new, down in (("a\n", long, True), (long, "a\n", False)):
        lines = []
        for f in frames(old, new):
            if f[0] == "key":
                text, _, line, col = f[1:]
                assert line <= text.count("\n") + 1 and col >= 1, (f, down)
                lines.append(line)
        assert len(set(lines)) >= 50 and lines == sorted(lines, reverse=not down), down
    print("ok")


def keep_paths(path, key):
    """Where a hard link to the original file can live: must be on the file's filesystem."""
    p = Path(path)
    return [KEEP_DIR / key, p.with_name(f".{p.name}.claude-typing")]


def keep_inode(path, key):
    for keep in keep_paths(path, key):
        try:
            keep.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            keep.unlink(missing_ok=True)
            os.link(path, keep)
            return
        except OSError:
            continue  # e.g. other filesystem: try the next place


def restore_inode(path, key):
    """Claude's Edit replaces the file (new inode), which kills an editor's watch on a single opened
    file. Put the original inode back so the replay's in-place writes reach the editor."""
    for keep in keep_paths(path, key):
        try:
            if os.stat(keep).st_ino != os.stat(path).st_ino:
                os.replace(keep, path)
            else:
                keep.unlink()
        except OSError:
            continue


# remember which file finished last and when, so a new file waits until it has been seen
LAST_FILE = STATE_DIR / "last"


def mark_file_done(path):
    LAST_FILE.write_text(f"{time.time()}\n{path}")


def wait_for_other_file(path):
    try:
        finished, last_path = LAST_FILE.read_text().split("\n", 1)
        until = float(finished) + FILE_PAUSE
    except (OSError, ValueError):
        return
    while last_path != path and time.time() < until and not OFF.exists():
        time.sleep(0.1)


def hook():
    event = json.load(sys.stdin)
    path = (event.get("tool_input") or {}).get("file_path")
    if not path:
        return
    key = hashlib.sha1(path.encode()).hexdigest()
    snap = STATE_DIR / key

    if event.get("hook_event_name") == "PreToolUse":
        if OFF.exists():
            return
        STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
        if not os.path.exists(path):
            write(snap, "")
        elif os.path.isfile(path):
            write(snap, read(path))
            keep_inode(path, key)
        return

    if not snap.exists() or not os.path.isfile(path):
        return
    old = read(snap)
    snap.unlink()
    new = read(path)
    st = os.stat(path)
    restore_inode(path, key)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    try:
        # give the user time to look at the previous file before jumping to this one
        if old != new:
            wait_for_other_file(path)
            # rewind on disk and replay from there; your own cursor follows the typing
            write(path, old)
            animate(path, frames(old, new), len(new))
    except OSError:
        pass  # the disk stopped taking frames mid-replay; the final write below still lands
    finally:
        write(path, new)
        # keep the post-edit mtime so Claude Code doesn't see the file as changed since its edit
        os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns))
        # record that this file just finished
        mark_file_done(path)


def main():
    match sys.argv[1:]:
        case ["selftest"]:
            selftest()
        case ["speed"]:
            print(f"{speed():g} chars/s")
        case ["speed", value]:
            SPEED_FILE.parent.mkdir(parents=True, exist_ok=True)
            SPEED_FILE.write_text(f"{max(1.0, float(value)):g}\n")
            print(f"{speed():g} chars/s")
        case ["off"]:
            STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
            OFF.touch()
        case ["on"]:
            OFF.unlink(missing_ok=True)
        case _:
            hook()


if __name__ == "__main__":
    main()
