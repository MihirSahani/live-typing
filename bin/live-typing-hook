#!/bin/sh
# Hook entry point: run claude-typing with the first Python that really starts.
# Windows often has only `python` or `py`, and a `python3` stub that just opens the Microsoft Store.
script="$(dirname "$0")/claude-typing"
for py in python3 python py; do
    if "$py" -c "" </dev/null >/dev/null 2>&1; then
        exec "$py" "$script" "$@"
    fi
done
echo "live-typing: no working Python found (tried python3, python, py)" >&2
exit 1
